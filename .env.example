# ==============================================================================
# Swamina International - Tender Aggregator Configuration
# NOTE: Credentials are read ONLY from this local .env file.
# Never commit this file or put credentials into Claude Desktop JSON config!
# ==============================================================================

# HMEL e-procurement credentials (mjunction portal)
HMEL_USERNAME=your_username_here
HMEL_PASSWORD=your_password_here

# Playwright browser mode (set false for visible browser debugging)
HEADLESS=true

# Max pages to scrape per refresh cycle
CPPP_MAX_PAGES=3
GEM_MAX_PAGES=3

# Web Dashboard (FastAPI)
DASHBOARD_USER=swamina
DASHBOARD_PASSWORD=your_secure_password_here
DASHBOARD_OWNERS=

# Email alerts (SMTP) & Slack
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=
DIGEST_TO=
SLACK_WEBHOOK_URL=

# Email alerts safety switch (must be true to allow real send)
DIGEST_ENABLED=false
